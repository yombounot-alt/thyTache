# Mettre à "true" pour travailler sur l'UI sans backend (données en mémoire).
# Le backend Express est maintenant branché pour l'authentification (Point 3).
VITE_USE_MOCKS=false

# URL de base de l'API backend (doit correspondre à PORT + API_PREFIX de backend/.env).
VITE_API_BASE_URL=http://localhost:3000/api/v1
