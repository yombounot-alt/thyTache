# ============================
# Application
# ============================
NODE_ENV=development
PORT=3000
APP_NAME=backend-api
API_PREFIX=/api/v1

# ============================
# CORS
# ============================
# Liste d'origines autorisées, séparées par des virgules. Utiliser "*" pour tout autoriser (déconseillé en production).
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ============================
# Rate limiting
# ============================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=5

# ============================
# JWT (JWT_SECRET = access token, JWT_REFRESH_SECRET = refresh token)
# ============================
JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production
JWT_REFRESH_EXPIRES_IN=7d

# ============================
# Cookies
# ============================
COOKIE_SECRET=change_this_cookie_secret_in_production

# ============================
# Bcrypt
# ============================
BCRYPT_SALT_ROUNDS=12

# ============================
# Payload
# ============================
JSON_BODY_LIMIT=10kb

# ============================
# Logs
# ============================
LOG_LEVEL=info

# ============================
# Base de données (MongoDB)
# ============================
# Développement local : utiliser 127.0.0.1 plutôt que localhost.
# Production / MongoDB Atlas : remplacer par l'URI fournie par Atlas
# (ex: mongodb+srv://user:password@cluster.mongodb.net/task_management)
MONGODB_URI=mongodb://127.0.0.1:27017/task_management

# Base dédiée utilisée par `npm test` (jamais la base de dev/prod).
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/task_management_test

# ============================
# OTP (vérification e-mail / réinitialisation mot de passe)
# ============================
OTP_EXPIRES_IN_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ============================
# SMTP (envoi des e-mails contenant les codes OTP)
# ============================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="backend-api <no-reply@example.com>"
